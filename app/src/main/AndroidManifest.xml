<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="br.jss.motoreviso">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotoReviso"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- Login Activity (launcher) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup PIN -->
        <activity
            android:name=".activities.SetupPinActivity"
            android:exported="false"
            android:label="Configurar PIN" />

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Detalhe Manutenção -->
        <activity
            android:name=".activities.DetalheManutencaoActivity"
            android:exported="false" />

        <!-- Cadastro Veículo -->
        <activity
            android:name=".activities.CadastroVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/cadastro_veiculo" />

        <!-- Detalhe Veículo -->
        <activity
            android:name=".activities.DetalheVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/detalhe_veiculo" />

        <!-- Editar Veículo -->
        <activity
            android:name=".activities.EditarVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/editar_veiculo" />

        <!-- Rastreamento -->
        <activity
            android:name=".activities.RastreamentoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/rastreamento"
            android:screenOrientation="portrait" />

        <!-- Cadastro Manutenção -->
        <activity
            android:name=".activities.CadastroManutencaoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/cadastro_manutencao" />

        <!-- Galeria Veículo -->
        <activity
            android:name=".activities.GaleriaVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/galeria" />

        <!-- Mapa do Trajeto -->
        <activity
            android:name=".activities.MapTrajetoActivity"
            android:exported="false"
            android:label="Mapa do Trajeto" />

        <!-- Foreground Service de Rastreamento -->
        <service
            android:name=".services.RastreamentoService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Receiver para controles da notificação -->
        <receiver
            android:name=".receivers.RastreamentoReceiver"
            android:exported="false" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

    </application>

</manifest>
