<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="br.jss.motoreviso">

    <!-- Permissões necessárias -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotoReviso"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Detalhe Manutenção -->
        <activity
            android:name=".activities.DetalheManutencaoActivity"
            android:exported="false" />

        <!-- Cadastro Veículo -->
        <activity
            android:name=".activities.CadastroVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/cadastro_veiculo" />

        <!-- Detalhe Veículo -->
        <activity
            android:name=".activities.DetalheVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/detalhe_veiculo" />

        <!-- Editar Veículo -->
        <activity
            android:name=".activities.EditarVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/editar_veiculo" />

        <!-- Rastreamento -->
        <activity
            android:name=".activities.RastreamentoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/rastreamento"
            android:screenOrientation="portrait" />

        <!-- Cadastro Manutenção -->
        <activity
            android:name=".activities.CadastroManutencaoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/cadastro_manutencao" />

        <!-- Galeria Veículo -->
        <activity
            android:name=".activities.GaleriaVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/galeria" />

    </application>

</manifest>