<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="br.jss.motoreviso">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Central Bluetooth (celular ⇄ painel do guidão) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotoReviso"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <!-- Login Activity (launcher) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup PIN -->
        <activity
            android:name=".activities.SetupPinActivity"
            android:exported="false"
            android:label="Configurar PIN"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:label="Criar Conta"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (fragments com formulários — usa adjustPan + stateHidden para melhor controle) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <!-- Detalhe Manutenção -->
        <activity
            android:name=".activities.DetalheManutencaoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cadastro Veículo -->
        <activity
            android:name=".activities.CadastroVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/cadastro_veiculo"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalhe Veículo -->
        <activity
            android:name=".activities.DetalheVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/detalhe_veiculo"
            android:windowSoftInputMode="adjustResize" />

        <!-- Editar Veículo -->
        <activity
            android:name=".activities.EditarVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/editar_veiculo"
            android:windowSoftInputMode="adjustResize" />

        <!-- Rastreamento (sem formulário, sem softInput especial) -->
        <activity
            android:name=".activities.RastreamentoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/rastreamento"
            android:screenOrientation="portrait" />

        <!-- Cadastro Manutenção -->
        <activity
            android:name=".activities.CadastroManutencaoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/cadastro_manutencao"
            android:windowSoftInputMode="adjustResize" />

        <!-- Galeria Veículo -->
        <activity
            android:name=".activities.GaleriaVeiculoActivity"
            android:exported="false"
            android:parentActivityName=".activities.DetalheVeiculoActivity"
            android:label="@string/galeria" />

        <!-- Mapa do Trajeto -->
        <activity
            android:name=".activities.MapTrajetoActivity"
            android:exported="false"
            android:label="Mapa do Trajeto" />

        <!-- Pilotos -->
        <activity
            android:name=".activities.CadastroPilotoActivity"
            android:exported="false"
            android:label="@string/cadastro_piloto"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.PilotProfileActivity"
            android:exported="false"
            android:label="@string/perfil_piloto"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.CadastroEquipamentoActivity"
            android:exported="false"
            android:label="@string/cadastro_equipamento"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.AvatarPilotoActivity"
            android:exported="false"
            android:label="Avatar do Piloto"
            android:screenOrientation="portrait" />

        <!-- Foreground Service de Rastreamento -->
        <service
            android:name=".services.RastreamentoService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Receiver para controles da notificação -->
        <receiver
            android:name=".receivers.RastreamentoReceiver"
            android:exported="false" />

        <!-- ── Central Bluetooth ── -->
        <activity
            android:name=".activities.CentralBluetoothActivity"
            android:exported="false"
            android:label="Central Bluetooth" />

        <activity
            android:name=".activities.PainelActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:label="Painel Moto"
            android:launchMode="singleTask" />

        <!-- Atalho na tela inicial do painel: abre direto, sem login -->
        <activity-alias
            android:name=".PainelLauncher"
            android:exported="true"
            android:icon="@drawable/icon"
            android:label="Painel Moto"
            android:targetActivity=".activities.PainelActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".central.PhoneLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".central.PhoneNotificationListener"
            android:exported="true"
            android:label="Moto Reviso · Painel do guidão"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".central.CentralBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

    </application>

</manifest>
