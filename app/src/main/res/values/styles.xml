<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotoReviso" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorPrimaryVariant">@color/secondary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="materialButtonStyle">@style/Widget.MotoReviso.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MotoReviso.Card</item>
        <!-- Dialog button colors -->
        <item name="android:buttonBarButtonStyle">@style/Widget.MotoReviso.Button.Dialog</item>
    </style>

    <style name="Widget.MotoReviso.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/secondary</item>
    </style>

    <style name="Widget.MotoReviso.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/secondary</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Dialog Button Style with White Text -->
    <style name="Widget.MotoReviso.Button.Dialog" parent="android:Widget.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.MotoReviso.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider_strong</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MotoReviso.CardModern" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider_strong</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MotoReviso.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_variant</item>
        <item name="boxStrokeColor">@color/secondary</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- Base TextAppearance (required as parent for dot-notation children) -->
    <style name="TextAppearance.MotoReviso" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Section header text -->
    <style name="TextAppearance.MotoReviso.SectionHeader" parent="TextAppearance.MotoReviso">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Display headline -->
    <style name="TextAppearance.MotoReviso.Display" parent="TextAppearance.MotoReviso">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Numeric / digit value -->
    <style name="TextAppearance.MotoReviso.Digit" parent="TextAppearance.MotoReviso">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
