<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Imagem do Veículo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_placeholder_image"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/img_veiculo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Imagem do veículo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="FOTO DO VEÍCULO"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Status Badge -->
            <LinearLayout
                android:id="@+id/status_badge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:background="@drawable/bg_status_badge"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@color/secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Principal"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Nome do Veículo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/text_marca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YAMAHA"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/text_modelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MT-07"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Informações (Quilometragem e Revisão) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUILOMETRAGEM"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_quilometragem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14.820 km"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÓX. REVISÃO"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_proxima_revisao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 jul"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botão Definir como Principal -->
        <Button
            android:id="@+id/btn_principal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Definir como principal"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/secondary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
