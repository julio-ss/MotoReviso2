<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_veiculo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- content_layout é o alvo das animações TransitionManager -->
        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <!-- Tipo de Veículo (dropdown pesquisável) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_tipo_veiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MotoReviso.Dropdown"
                android:hint="@string/tipo_veiculo">

                <AutoCompleteTextView
                    android:id="@+id/acv_tipo_veiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:completionThreshold="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Imagem do Veículo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:strokeColor="@color/divider_strong"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/img_veiculo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_selecionar_imagem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/selecionar_imagem"
                android:layout_marginBottom="20dp"
                style="@style/Widget.MotoReviso.Button.Outlined"
                app:cornerRadius="14dp" />

            <!-- INFORMAÇÕES BÁSICAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_basico"
                android:layout_marginBottom="12dp"
                style="@style/TextAppearance.MotoReviso.SectionHeader" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_marca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/marca"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_modelo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/modelo"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_ano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ano"
                    android:inputType="number"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_placa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/placa"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_chassis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/chassis"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SEÇÃO MOTOR (visível quando possui motor convencional) -->
            <LinearLayout
                android:id="@+id/section_motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/secao_motor"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextAppearance.MotoReviso.SectionHeader" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_motor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/motor"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_cambio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/cambio"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        style="@style/Widget.MotoReviso.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_potencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/potencia"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/Widget.MotoReviso.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_torque"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/torque"
                            android:inputType="text"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_cilindrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/cilindrada"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- SEÇÃO ALIMENTAÇÃO (visível para todos com motor, inclusive elétrico) -->
            <LinearLayout
                android:id="@+id/section_alimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/secao_alimentacao"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextAppearance.MotoReviso.SectionHeader" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_alimentacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MotoReviso.Dropdown"
                    android:hint="@string/tipo_alimentacao">

                    <AutoCompleteTextView
                        android:id="@+id/acv_alimentacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tanque só para motores convencionais -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_tanque"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_tanque"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/tanque"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- SEÇÃO ELÉTRICO (visível apenas para veículos elétricos) -->
            <LinearLayout
                android:id="@+id/section_eletrico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/secao_eletrico"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    style="@style/TextAppearance.MotoReviso.SectionHeader" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        style="@style/Widget.MotoReviso.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_bateria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/capacidade_bateria"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/Widget.MotoReviso.EditText">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_autonomia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/autonomia"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_tempo_recarga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/tempo_recarga"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- DIMENSÕES E PESO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_fisico"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                style="@style/TextAppearance.MotoReviso.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_peso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/peso"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MotoReviso.EditText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_dimensoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/dimensoes"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- USO E MANUTENÇÃO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secao_uso"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                style="@style/TextAppearance.MotoReviso.SectionHeader" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_km_atual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/km_atual"
                    android:inputType="number"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_intervalo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/intervalo_revisao"
                    android:inputType="number"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MotoReviso.EditText">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_descricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/descricao"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Botões de ação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_salvar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/salvar_veiculo"
            android:layout_marginEnd="8dp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/cancelar"
            android:layout_marginStart="8dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/surface_variant"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>
