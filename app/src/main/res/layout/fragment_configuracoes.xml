<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="80dp">

        <TextView
            android:id="@+id/text_configuracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/configuracoes"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp" />

        <!-- About card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/divider_strong"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SOBRE O APP"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sobre_o_app"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/versao"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/descricao_app"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Security section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEGURANÇA"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_configurar_pin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Configurar PIN / Biometria"
            android:layout_marginBottom="13dp"
            style="@style/Widget.MotoReviso.Button.Outlined"
            app:cornerRadius="14dp" />

        <!-- Account section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTA"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sair"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Sair da conta"
            app:backgroundTint="@color/error_dim"
            android:textColor="@color/error"
            app:strokeColor="#33FF4D4D"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>
