<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with GPS Status and Status Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS - 11 sat"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="@color/secondary"
                app:chipIcon="@drawable/ic_map_modern"
                app:chipIconTint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Status Indicator Dot -->
            <View
                android:id="@+id/status_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_circle_status"
                android:tint="@color/secondary" />

        </LinearLayout>

        <!-- Speedometer and Stats Side by Side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!-- Speedometer Circle -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginEnd="20dp">

                <ProgressBar
                    android:id="@+id/progress_speedometer"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="200"
                    android:progress="96"
                    android:progressDrawable="@drawable/bg_progress_circular" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_velocidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96"
                        android:textColor="@android:color/white"
                        android:textSize="52sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Right Side Stats -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="8dp">

                <!-- Vel Max -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEL. MÁX"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/text_vel_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="138"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <!-- Tempo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPO"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/text_tempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Speed Indicators Line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <View
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:background="@color/secondary"
                android:layout_marginHorizontal="4dp" />

            <View
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:background="@color/secondary"
                android:layout_marginHorizontal="4dp" />

            <View
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:background="@color/secondary"
                android:layout_marginHorizontal="4dp" />

            <View
                android:layout_width="16dp"
                android:layout_height="3dp"
                android:background="@color/secondary"
                android:layout_marginHorizontal="4dp" />

        </LinearLayout>

        <!-- Stats Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <!-- Distância -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_card_surface"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTÂNCIA"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/text_distancia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Altitude -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_card_surface"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALTITUDE"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/text_altitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="m"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Inclinação -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_card_surface"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INCLINAÇÃO"
                    android:textSize="9sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/text_inclinacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </GridLayout>

        <!-- Coordinates -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAT -28.4512  LNG -49.3961"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.05" />

        <!-- Controle de Rastreamento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:weightSum="3"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_iniciar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Iniciar"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_marginEnd="6dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pausar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Pausar"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_marginHorizontal="6dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/warning"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_parar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Parar"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_marginStart="6dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary" />

        </LinearLayout>

        <!-- Ver Mapa Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ver_mapa"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ver Mapa"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_map_modern"
            app:iconGravity="textStart" />

        <!-- Histórico Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_historico"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Histórico de Rastreamento"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="80dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/secondary"
            app:icon="@drawable/ic_map_modern"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
