<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- BottomAppBar com FAB centralizado -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        app:fabCradleMargin="16dp"
        app:fabCradleRoundedCornerRadius="18dp"
        app:hideOnScroll="false">

        <!-- Custom Navigation Items -->
        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@android:color/transparent">

            <!-- Item 1: Início -->
            <LinearLayout
                android:id="@+id/nav_item_inicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_car_modern"
                    android:tint="@color/nav_item_color"
                    android:contentDescription="Início"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Início"
                    android:textSize="10sp"
                    android:textColor="@color/nav_item_color"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Item 2: Garagem -->
            <LinearLayout
                android:id="@+id/nav_item_garagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_car_modern"
                    android:tint="@color/nav_item_color"
                    android:contentDescription="Garagem"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Garagem"
                    android:textSize="10sp"
                    android:textColor="@color/nav_item_color"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Item 3: Manutenção -->
            <LinearLayout
                android:id="@+id/nav_item_manutencao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_wrench_modern"
                    android:tint="@color/nav_item_color"
                    android:contentDescription="Manutenção"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manutenção"
                    android:textSize="10sp"
                    android:textColor="@color/nav_item_color"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Item 4: Mais -->
            <LinearLayout
                android:id="@+id/nav_item_mais"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_settings_modern"
                    android:tint="@color/nav_item_color"
                    android:contentDescription="Mais"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mais"
                    android:textSize="10sp"
                    android:textColor="@color/nav_item_color"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- FAB Centralizado para Rastreamento -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_rastreamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_map_modern"
        android:contentDescription="@string/menu_trajetos"
        app:fabSize="normal"
        app:layout_anchor="@id/bottom_app_bar"
        app:layout_anchorGravity="top|center"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white"
        android:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
