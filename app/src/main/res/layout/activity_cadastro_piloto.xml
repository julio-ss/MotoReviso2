<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_titulo_cadastro_piloto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_piloto"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- ScrollView principal -->
    <ScrollView
        android:id="@+id/scroll_view_piloto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- ─── DADOS PESSOAIS ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DADOS PESSOAIS"
                style="@style/TextAppearance.MotoReviso.SectionHeader"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Nome Completo *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_nome_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Apelido">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_apelido_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Número do Piloto (ex: 46)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_numero_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Data de nascimento -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Data de Nascimento">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_data_nascimento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Peso + Altura lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MotoReviso.EditText"
                    android:hint="Peso (kg)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_peso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MotoReviso.EditText"
                    android:hint="Altura (cm)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_altura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Tipo sanguíneo + Nacionalidade lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_tipo_sanguineo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MotoReviso.Dropdown"
                    android:hint="Tipo Sanguíneo">
                    <AutoCompleteTextView
                        android:id="@+id/acv_tipo_sanguineo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:completionThreshold="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.MotoReviso.EditText"
                    android:hint="Nacionalidade">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_nacionalidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Cidade">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_cidade_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ─── CONTATO ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTATO"
                style="@style/TextAppearance.MotoReviso.SectionHeader"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Telefone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_telefone_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="E-mail">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_email_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Contato de Emergência (Nome e Telefone)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_contato_emergencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ─── PILOTAGEM ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILOTAGEM"
                style="@style/TextAppearance.MotoReviso.SectionHeader"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_categoria_piloto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.Dropdown"
                android:hint="Categoria">
                <AutoCompleteTextView
                    android:id="@+id/acv_categoria_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Anos de Experiência">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_anos_experiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Equipe">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_equipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Corridas + Vitórias + Quedas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.MotoReviso.EditText"
                    android:hint="Corridas">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_num_corridas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    style="@style/Widget.MotoReviso.EditText"
                    android:hint="Vitórias">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_num_vitorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    style="@style/Widget.MotoReviso.EditText"
                    android:hint="Quedas">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_num_quedas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Melhor Tempo de Volta (ex: 1:32.456)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_melhor_tempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                style="@style/Widget.MotoReviso.EditText"
                android:hint="Observações Gerais">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_observacoes_piloto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ─── AVATAR ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AVATAR"
                style="@style/TextAppearance.MotoReviso.SectionHeader"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <!-- Preview do avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- Preview circular -->
                <FrameLayout
                    android:id="@+id/frame_avatar_preview"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:id="@+id/tv_avatar_numero_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="#"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                </FrameLayout>

                <!-- Seletores de cor -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cor_fundo"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Cor do Fundo"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cor_numero"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Cor do Número"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/surface_variant"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

    <!-- Botões de ação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_salvar_piloto"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Salvar"
            android:layout_marginEnd="8dp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelar_piloto"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:layout_marginStart="8dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/surface_variant"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>
